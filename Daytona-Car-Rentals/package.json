    "admin:setup": "node scripts/admin-setup.mjs",
    "db:migrate": "node --import tsx scripts/db.ts migrate",
    "db:seed": "node --import tsx scripts/db.ts seed-demo",
    "db:init-live": "node --import tsx scripts/db.ts init-live",
    "test:preview-origin": "node --conditions=react-server --import tsx tests/preview-origin.test.ts",
    "test:portal": "node --conditions=react-server --import tsx tests/portal.test.ts && node --conditions=react-server --import tsx tests/outbox.test.ts && node --conditions=react-server --import tsx tests/auth-isolation.test.ts"
  },
  "dependencies": {
