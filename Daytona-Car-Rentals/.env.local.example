# Server-only Postgres configuration. No SQLite or implicit demo fallback.
# Use DIFFERENT projects/databases and credentials for live, preview and development.
DCR_DEMO_MODE=true
# LOCAL DEVELOPMENT ONLY: restricted loopback Postgres demo login inheriting dcr_app.
# Hosted daytona-rentals-dev is exclusively Vercel Preview; do not use its URL here.
# Load local private configuration outside Git; never use NEXT_PUBLIC_ for credentials.
DCR_DATABASE_URL=
# TLS verification is always enabled remotely; optional CA PEM (literal \n supported).
DCR_DATABASE_CA=
# Only for local loopback Postgres; leave blank on Vercel.
DCR_DATABASE_SSL=
# Migration owner DIRECT/session URL; set only in an operator shell, never runtime Vercel env.
DCR_MIGRATION_DATABASE_URL=
# Generate with npm run admin:setup; never commit the resulting hash.
DCR_ADMIN_PASSWORD_HASH=
DCR_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://daytonacarrentals.com
