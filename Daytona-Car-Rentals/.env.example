# Server-only Postgres configuration. No SQLite or implicit demo fallback.
# Use DIFFERENT projects/databases and credentials for live, preview and development.
DCR_DEMO_MODE=false
# Runtime: restricted LOGIN role inheriting dcr_app; Supavisor transaction mode (6543) on Vercel.
# Copy the exact host/username from Supabase Connect; never use NEXT_PUBLIC_ for credentials.
DCR_DATABASE_URL=
# TLS verification is always enabled remotely; optional CA PEM (literal \n supported).
DCR_DATABASE_CA=
# Only for local loopback Postgres; leave blank on Vercel.
DCR_DATABASE_SSL=
# Migration owner DIRECT/session URL; set only in an operator shell, never runtime Vercel env.
DCR_MIGRATION_DATABASE_URL=
# Generate with npm run admin:setup; never commit the resulting hash.
DCR_ADMIN_PASSWORD_HASH=
DCR_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://daytonacarrentals.com

# Customer Auth: Daytona-only project. No service-role or migration-owner key needed.
DCR_SUPABASE_AUTH_URL=
DCR_SUPABASE_PROJECT_REF=
DCR_SUPABASE_PUBLISHABLE_KEY=
# Preview only: comma-separated, explicitly approved magic-link test recipients.
# Empty means no Preview sign-in email may be sent.
DCR_AUTH_TEST_EMAILS=
# Separate transactional mail; Preview always captures even if mode is misconfigured.
DCR_EMAIL_MODE=capture
DCR_EMAIL_API_KEY=
DCR_EMAIL_FROM=
DCR_OWNER_EMAIL=
