# Custom Node/SQLite pilot. No vendor keys are required for preview.
# Use separate databases for preview and live rentals.
DCR_DEMO_MODE=false
DCR_DATABASE_PATH=data/live.sqlite
# Generate locally with npm run admin:setup. Never commit the resulting hash.
DCR_ADMIN_PASSWORD_HASH=
# Required explicit production origin, including https.
DCR_SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://daytonacarrentals.com
